# =================================================================
# DRUTO PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# =================================================================

# Database Connection (TiDB Serverless / Cloud MySQL)
# Format: mysql://<username>:<password>@<gateway-host>:4000/<database_name>?ssl={"rejectUnauthorized":true}
# Leave empty for offline local development (automatic in-memory fallback)
DATABASE_URL="mysql://username:password@gateway01.region.prod.aws.tidbcloud.com:4000/druto?ssl={\"rejectUnauthorized\":true}"

# Session Secret (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="your-32-character-or-longer-random-jwt-secret-key"

# Application Environment
NODE_ENV="development"
PORT=3000

# Arc Testnet Configuration (Pre-configured for Arc Testnet USDC)
ARC_RPC_URL="https://rpc.testnet.arc.io"
ARC_CHAIN_ID=5042002
ARC_USDC_ADDRESS="0x3600000000000000000000000000000000000000"
ARC_MERCHANT_WALLET_ADDRESS="0xA32c7bbB2fb634bED4DfC812c15AF87a0C727217"

# Privy Authentication (Get from https://dashboard.privy.io)
# Note: VITE_PRIVY_APP_ID is exposed to the browser for PrivyProvider
VITE_PRIVY_APP_ID="cm7xxxxxxxxxxxxxxxxxxxxx"
PRIVY_APP_ID="cm7xxxxxxxxxxxxxxxxxxxxx"
PRIVY_APP_SECRET="privy_sk_xxxxxxxxxxxxxxxxxxxxxx"
