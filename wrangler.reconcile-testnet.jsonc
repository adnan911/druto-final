{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "druto-d1-testnet-reconciler",
  "main": "workers/testnet-reconciler/index.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    { "binding": "DRUTO_D1", "database_name": "druto-d1-testnet",
      "database_id": "d1f68dd0-c984-4b56-8167-d4ae0ee70ca2" },
    { "binding": "LUVRE_ORDERS_DB", "database_name": "luvre-d1-testnet",
      "database_id": "ee1a3142-79b4-461d-8af1-5c3a7627623b" }
  ],
  "observability": { "enabled": true, "issues": { "enabled": true } }
}
