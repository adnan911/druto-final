{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "druto-final",
  "main": "./workers/druto-app/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "alias": { "iconv-lite": "./node_modules/iconv-lite" },
  "workers_dev": true,
  "preview_urls": true,
  "vars": { "DRUTO_RUNTIME": "cloudflare" },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/trpc/*", "/manus-storage/*"]
  },
  "previews": {
    "vars": { "DRUTO_RUNTIME": "cloudflare" }
  },
  "observability": { "enabled": true }
}
